# Template for .env — copy to .env and fill in. This example file is committed; .env is not.
# Format: NAME=value (no quotes needed, no spaces around =). Real environment variables win over this file.

# Wallex challenge account API key (required for verify-api and live trading)
WALLEX_API_KEY=

# OpenAI API key (GPT overlay agent + headline scoring)
OPENAI_API_KEY=

# Optional: OpenAI-compatible gateway (leave empty for https://api.openai.com/v1)
OPENAI_BASE_URL=

# Optional: GPT models (leave empty to use config.yaml agent.screen_model / agent.decision_model)
OPENAI_SCREEN_MODEL=
OPENAI_DECISION_MODEL=

# Optional: Wallex MCP server (read-only tools for the agent), if the organizers provide one
WALLEX_MCP_URL=
WALLEX_MCP_API_KEY=
